# systemd unit for Home Sweet Home.
# Install (replaces __USER__ and __DIR__ with your user and clone path):
#   mkdir -p data
#   sed -e "s|__USER__|$USER|g" -e "s|__DIR__|$PWD|g" deploy/homesweethome.service \
#     | sudo tee /etc/systemd/system/homesweethome.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now homesweethome
# See DEPLOY.md.

[Unit]
Description=Home Sweet Home (kitchen and household assistant)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=PORT=424
Environment=LAR_DB=__DIR__/data/lar.db
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 __DIR__/server.py
Restart=on-failure
RestartSec=3

# Ports below 1024 need this capability; the service still runs as __USER__, not root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening: read-only system, writes only to the data folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__DIR__/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
